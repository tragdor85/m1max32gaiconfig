# m1max32gaiconfig — environment variables
#
# Copy to `.env` (gitignored) and fill in your own values, then run:
#   scripts/render.sh          # materializes pi/mcp.json + pi/SYSTEM.md from templates
#   scripts/install.sh         # full mirror (renders + installs + wires everything)
#
# Every file in this repo that would contain a personal value uses
# {{PLACEHOLDER}} syntax; render.sh substitutes from the variables below.

# Where your code lives on disk.  All ~/code/ paths use this variable so a
# fresh developer can point everything to a different location:
#   export CODE_DIR=~/projects   (or set it here in .env)
# Default: $HOME/code (the historic location).
CODE_DIR=$HOME/code

# --- Identity -------------------------------------------------------------
# Phone number used by the global system prompt to notify you when a task finishes.
PI_NOTIFY_PHONE=+15551230000

# --- Splash (local 27B model server, see docs/04-splash.md) ---------------
# Clone of your M1/M2 Metal-kernel fork of Inco splash (tag 1.3.2-m1.1).
SPLASH_REPO=$CODE_DIR/splash
# Port the splash HTTP server listens on.
SPLASH_PORT=8000

# --- splash-serve launcher + watchdog (see docs/04-splash.md) -------------
SPLASH_SERVE_REPO=https://github.com/tragdor85/splash-serve
# Context length, e.g. 80000 / 64K. 80K is the practical ceiling on 32 GB.
SPLASH_MAX_CONTEXT=80000
# tmux session the watchdog relaunches the server in.
SPLASH_TMUX=splash
# Working directory for relaunches.
SPLASH_CWD=$CODE_DIR/splash
# launchd label for the watchdog agent.
SPLASH_WATCHDOG_LABEL=com.piagent.splash-watchdog

# --- MCP servers (see docs/06-mcp.md) --------------------------------------
# Local uv tool that reads ~/Library/Music via the Music.app CLI.
APPLE_MUSIC_MCP_BIN=$HOME/.local/bin/applemusic-mcp
# System Safari WebDriver (requires: safaridriver --enable-automation, one time).
SAFARI_MCP_BIN=/usr/bin/safaridriver

# --- Local repos, now public (see docs/05-extensions.md, docs/07-sanitizing-local-repos.md)
# All three are public; install.sh clones them (a checked-out local copy is
# reused if one already exists at the expected path). Leave a value empty to
# use the vendored fallback instead (pi-imessage, global-todo) or skip.
PI_TODO_ORIGIN=https://github.com/tragdor85/pi-todo
PI_IMESSAGE_REPO=https://github.com/tragdor85/pi-imessage
# pi-imessage: email for contact lookup (phone comes from PI_NOTIFY_PHONE).
PI_IMESSAGE_ME_EMAIL=
