# m1max32gaiconfig — environment variables
#
# Copy to `.env` (gitignored) and fill in your own values, then run:
#   scripts/render.sh          # materializes pi/mcp.json + pi/SYSTEM.md from templates
#   scripts/install.sh         # full mirror (renders + installs + wires everything)
#
# Every file in this repo that would contain a personal value uses
# {{PLACEHOLDER}} syntax; render.sh substitutes from the variables below.

# --- Identity -------------------------------------------------------------
# Phone number used by the global system prompt to notify you when a task finishes.
PI_NOTIFY_PHONE=+15551230000

# --- Splash (local 27B model server, see docs/04-splash.md) ---------------
# Clone of your M1/M2 Metal-kernel fork of Inco splash (tag 1.3.2-m1.1).
SPLASH_REPO=$HOME/code/splash
# Port the splash HTTP server listens on.
SPLASH_PORT=8000

# --- splash-serve launcher + watchdog (see docs/04-splash.md) -------------
SPLASH_SERVE_REPO=$HOME/code/splash-serve
# Model the server loads (any model in models.json or installed via `splash install`).
SPLASH_MODEL=mlx-community/Qwen3.8-27B-4bit
# 80 K context on 32 GB RAM; 45 K is the comfortable floor, 80 K the practical ceiling.
SPLASH_CONTEXT=80000
SPLASH_KV=int8
SPLASH_THINKING=xhigh
# launchd label for the watchdog agent.
SPLASH_WATCHDOG_LABEL=com.piagent.splash-watchdog

# --- MCP servers (see docs/06-mcp.md) --------------------------------------
# Local uv tool that reads ~/Library/Music via the Music.app CLI.
APPLE_MUSIC_MCP_BIN=$HOME/.local/bin/applemusic-mcp
# System Safari WebDriver (requires: safaridriver --enable-automation, one time).
SAFARI_MCP_BIN=/usr/bin/safaridriver
# Home Assistant (REST/MCP endpoint + long-lived access token from HA UI).
HOME_ASSISTANT_URL=http://127.0.0.1:8123/api/mcp
HOME_ASSISTANT_TOKEN=
# Public Sonos Cloud MCP endpoint.
SONOS_MCP_URL=https://mcp.ws.sonos.com/mcp

# --- Local-only repos (see docs/05-extensions.md, docs/07-sanitizing-local-repos.md)
# Clone URL for the global-todo skill repo (private on this machine's owner).
# Empty = skip skill installation.
PI_TODO_ORIGIN=
# Working directory of the pi-imessage extension repo (local-only, no remote).
# Empty = skip iMessage extension installation.
PI_IMESSAGE_REPO=$HOME/code/pi-imessage
# pi-imessage config values (also needed in ~/.pi/agent/pi-imessage/config.json).
PI_IMESSAGE_ME_PHONE=
PI_IMESSAGE_ME_EMAIL=
PI_IMESSAGE_ALLOW_FROM=

# --- oMLX app (see docs/03-models.md) ---------------------------------------
# Local OpenAI-compatible MLX server (Ollama-alike). Port it exposes.
OMLX_PORT=8089

# --- LM Studio (optional, dormant on this machine) --------------------------
LMSTUDIO_PORT=1234
