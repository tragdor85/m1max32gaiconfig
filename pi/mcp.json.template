{
  "mcpServers": {
    "apple-music": {
      "command": "{{APPLE_MUSIC_MCP_BIN}}",
      "args": ["serve"]
    },
    "safari-mcp": {
      "command": "{{SAFARI_MCP_BIN}}",
      "args": ["--mcp"]
    },
    "home-assistant": {
      "url": "{{HOME_ASSISTANT_URL}}",
      "headers": {
        "Authorization": "Bearer {{HOME_ASSISTANT_TOKEN}}"
      }
    },
    "sonos": {
      "url": "{{SONOS_MCP_URL}}"
    }
  }
}
