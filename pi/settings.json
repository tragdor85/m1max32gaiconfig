{
  "lastChangelogVersion": "1.3.0",
  "theme": "dark",
  "transport": "auto",
  "packages": [
    "npm:@firstpick/pi-extension-git-footer-status"
  ],
  "defaultProvider": "splash",
  "defaultModel": "splash/mlx-community/Qwen3.8-27B-4bit",
  "enabledModels": [
    "splash/mlx-community/Qwen3.8-27B-4bit",
    "splash/mlx-community/Qwen3.6-35B-A3B-4bit",
    "splash/prism-ml/Ternary-Bonsai-2-27B-gguf:PQ2_0"
